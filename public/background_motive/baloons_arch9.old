<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1080 2560" width="100%" height="100%" preserveAspectRatio="xMidYMin slice">
  <defs>
    <!-- Paleta de Colores Pasteles MATE -->
    <linearGradient id="ball-pastel-white" x1="0%" y1="0%" x2="0%" y2="0%">
      <stop offset="100%" stop-color="#F8FAFC" />
    </linearGradient>

    <linearGradient id="ball-pastel-black" x1="0%" y1="0%" x2="0%" y2="0%">
      <stop offset="100%" stop-color="#334155" />
    </linearGradient>

    <linearGradient id="patch-dark" x1="0%" y1="0%" x2="0%" y2="0%">
      <stop offset="100%" stop-color="#1E293B" />
    </linearGradient>

    <linearGradient id="patch-light" x1="0%" y1="0%" x2="0%" y2="0%">
      <stop offset="100%" stop-color="#F1F5F9" />
    </linearGradient>

    <!-- Colores para la Copa: Dorado y Plateado Mate -->
    <linearGradient id="trophy-gold" x1="0%" y1="0%" x2="0%" y2="0%">
      <stop offset="100%" stop-color="#FACC15" />
    </linearGradient>

    <linearGradient id="trophy-silver" x1="0%" y1="0%" x2="0%" y2="0%">
      <stop offset="100%" stop-color="#E2E8F0" />
    </linearGradient>

    <linearGradient id="trophy-silver-dark" x1="0%" y1="0%" x2="0%" y2="0%">
      <stop offset="100%" stop-color="#94A3B8" />
    </linearGradient>

    <!-- Sombra suave mate para dar leve profundidad sin encimar -->
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="2" dy="4" stdDeviation="4" flood-color="#0F172A" flood-opacity="0.1" />
    </filter>

    <!-- MOLDES DE PELOTAS DE FÚTBOL MATE -->
    
    <!-- 1. Pelota Blanca Mate (Pentágonos Oscuros) -->
    <g id="soccer-white">
      <circle cx="0" cy="0" r="50" fill="url(#ball-pastel-white)" />
      <g fill="url(#patch-dark)" opacity="0.85">
        <polygon points="0,-12 15,-2 9,17 -9,17 -15,-2" />
        <polygon points="-8,-46 8,-46 12,-35 -12,-35" />
        <polygon points="35,-23 42,-8 31,4 25,-12" />
        <polygon points="27,23 37,38 19,46 14,32" />
        <polygon points="-27,23 -37,38 -19,46 -14,32" />
        <polygon points="-35,-23 -42,-8 -31,4 -25,-12" />
      </g>
      <g stroke="#1E293B" stroke-width="2.5" opacity="0.35">
        <line x1="0" y1="-12" x2="0" y2="-35" />
        <line x1="15" y1="-2" x2="33" y2="-9" />
        <line x1="9" y1="17" x2="23" y2="35" />
        <line x1="-9" y1="17" x2="-23" y2="35" />
        <line x1="-15" y1="-2" x2="-33" y2="-9" />
      </g>
    </g>

    <!-- 2. Pelota Negra Mate (Pentágonos Claros) -->
    <g id="soccer-black">
      <circle cx="0" cy="0" r="50" fill="url(#ball-pastel-black)" />
      <g fill="url(#patch-light)" opacity="0.9">
        <polygon points="0,-12 15,-2 9,17 -9,17 -15,-2" />
        <polygon points="-8,-46 8,-46 12,-35 -12,-35" />
        <polygon points="35,-23 42,-8 31,4 25,-12" />
        <polygon points="27,23 37,38 19,46 14,32" />
        <polygon points="-27,23 -37,38 -19,46 -14,32" />
        <polygon points="-35,-23 -42,-8 -31,4 -25,-12" />
      </g>
      <g stroke="#F8FAFC" stroke-width="2.5" opacity="0.45">
        <line x1="0" y1="-12" x2="0" y2="-35" />
        <line x1="15" y1="-2" x2="33" y2="-9" />
        <line x1="9" y1="17" x2="23" y2="35" />
        <line x1="-9" y1="17" x2="-23" y2="35" />
        <line x1="-15" y1="-2" x2="-33" y2="-9" />
      </g>
    </g>

    <!-- MOLDE DE LA COPA DEL TORNEO (Dorado y Plateado) -->
    <g id="trophy">
      <!-- Base de la Copa -->
      <rect x="-45" y="45" width="90" height="20" rx="4" fill="url(#trophy-gold)" />
      <rect x="-35" y="38" width="70" height="8" rx="2" fill="url(#trophy-silver-dark)" />
      
      <!-- Tallo de la Copa (Plateado) -->
      <path d="M -15,10 L 15,10 L 10,38 L -10,38 Z" fill="url(#trophy-silver-dark)" />
      <ellipse cx="0" cy="20" rx="14" ry="5" fill="url(#trophy-silver)" />

      <!-- Cuerpo Principal de la Copa (Dorado) -->
      <path d="M -50,-50 C -50,-10 -25,10 0,10 C 25,10 50,-10 50,-50 Z" fill="url(#trophy-gold)" />
      <ellipse cx="0" cy="-50" rx="50" ry="14" fill="#FEF08A" />

      <!-- Detalles e Interiores Plateados -->
      <path d="M -35,-45 C -35,-15 -20,0 0,0 C 20,0 35,-15 35,-45 Z" fill="url(#trophy-silver)" opacity="0.9" />

      <!-- Asas de la Copa -->
      <path d="M -48,-35 C -80,-35 -70,-5 -40,0 C -48,-12 -46,-25 -35,-30 Z" fill="url(#trophy-gold)" />
      <path d="M 48,-35 C 80,-35 70,-5 40,0 C 48,-12 46,-25 35,-30 Z" fill="url(#trophy-gold)" />

      <path d="M -52,-30 C -72,-30 -62,-8 -42,-3 Z" fill="url(#trophy-silver)" opacity="0.8" />
      <path d="M 52,-30 C 72,-30 62,-8 42,-3 Z" fill="url(#trophy-silver)" opacity="0.8" />

      <!-- Número 10 del Cumpleaños -->
      <circle cx="0" cy="-22" r="18" fill="url(#trophy-silver-dark)" />
      <text x="0" y="-14" font-family="Arial, sans-serif" font-weight="900" font-size="22" fill="url(#trophy-gold)" text-anchor="middle">10</text>
    </g>
  </defs>

  <g filter="url(#shadow)">
    
    <!-- LADO IZQUIERDO: 5 pelotas en total (4 del arco superior + 1 de la columna) -->
    <use href="#soccer-black" transform="translate(110, 240) scale(1.1) rotate(-15)" />
    <use href="#soccer-white" transform="translate(180, 160) scale(1.1) rotate(10)" />
    <use href="#soccer-black" transform="translate(270, 105) scale(1.1) rotate(-8)" />
    <use href="#soccer-white" transform="translate(370, 70) scale(1.15) rotate(20)" />
    <use href="#soccer-white" transform="translate(80, 400) scale(1.1) rotate(12)" />

    <!-- LADO DERECHO: 5 pelotas en total (4 del arco superior + 1 de la columna) -->
    <use href="#soccer-black" transform="translate(710, 70) scale(1.15) rotate(-18)" />
    <use href="#soccer-white" transform="translate(810, 105) scale(1.1) rotate(12)" />
    <use href="#soccer-black" transform="translate(900, 160) scale(1.1) rotate(-10)" />
    <use href="#soccer-white" transform="translate(970, 240) scale(1.1) rotate(15)" />
    <use href="#soccer-black" transform="translate(1000, 400) scale(1.1) rotate(-10)" />

    <!-- ELEMENTO CENTRAL DEL ARCO: Copa del Torneo -->
    <use href="#trophy" transform="translate(540, 75) scale(0.98)" />

  </g>
</svg>
