3. Tabla birthdayPayments

Yo la haría así.

create table public."birthdayPayments" (

  id bigint generated by default as identity not null,

  created_at timestamp with time zone not null default now(),

  updated_at timestamp with time zone not null default now(),

  "birthdayEventId" bigint not null,

  provider text not null,

  "providerPaymentId" text null,

  currency text not null,

  price numeric(12,2) not null,

  discount numeric(12,2) not null default 0,

  "finalPrice" numeric(12,2) not null,

  "promotionName" text null,

  status text not null,

  "paidAt" timestamp with time zone null,

  constraint birthdayPayments_pkey
    primary key (id),

  constraint birthdayPayments_birthdayEventId_fkey
    foreign key ("birthdayEventId")
    references public."birthdayEvents"(id)
    on delete cascade

) TABLESPACE pg_default;
