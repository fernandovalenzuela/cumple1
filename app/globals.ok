@import "tailwindcss";

/* ---------------- REGLAS ---------------- */
/* REGLA: Todo formulario usa .admin-page*/
/* REGLA: Todos los iconos tendrán width:20px;height:20px;color:var(--admin-text-soft);*/
/* REGLA: Ningún componente del Admin puede usar clases de Invitación */

/* ----------------------------------------- */

/* =========================
   🧱 BASE (FALLBACK)
========================= */
:root {
  --color-bg-main: #ffffff;
  --color-bg-soft: #fce9f5;
  --color-bg-card:#ffffff;
  --color-bg-hero-from: #fce7f3;
  --color-bg-hero-to: #ffffff;

  --color-primary: #ec4899;
  --color-text-main: #1f2937;
  --color-text-soft: #4b5563; /*#6b7280;*/
  --color-text-gallery:#ffffff;

  --color-button: #374151;
  --color-button-hover: #111827;

  --color-border: #e5e7eb;

  --hero-animation-opacity: 0.3;
  --hero-animation-blur: 0px;
  --hero-animation-scale: 1;

  --color-bg-hero-InvitedTo: #ffffff;
  --color-text-on-primary:#ffffff;

  --color-error:#ef4444;
  --color-success:#16a34a;
  --color-text-muted:#9CA3AF;
}

/* ===================================================

   ADMINISTRACIÓN

   Variables utilizadas por el organizador

=================================================== */

/* =========================
   🧑‍💼 ADMIN UI
========================= */

:root {

  /* Fondo */

  --admin-bg:#f8fafc;

  --admin-surface: #ffffff;

  --admin-surface-soft: #fafafa;

  /* Colores */

  --admin-primary: #f97316;

  --admin-primary-hover: #ea580c;

  --admin-primary-soft: #fed7aa;

  /* Textos */

  --admin-font-helper:.85rem;

  --admin-text: #111827;

  --admin-text-soft: #6b7280;

  /* Bordes */

  --admin-border: #e5e7eb;

  /* Inputs */

  --admin-input-bg: #ffffff;

  --admin-input-border: #d1d5db;

  --admin-input-focus: #f97316;

  /* Estados */

  --admin-success: #22c55e;

  --admin-warning: #f59e0b;

  --admin-error: #ef4444;

  --admin-success-bg: #f0fdf4;

  --admin-warning-bg: #fffbeb;

  --admin-error-bg: #fef2f2;
  
  --admin-success-color: #22c55e;

  --admin-warning-color: #92400e;

  --admin-error-color: #b91c1c;

  --admin-success-border: 1px solid #bbf7d0;

  --admin-warning-border: 1px solid #fde68a;

  --admin-error-border: 1px solid #fecaca;



  --admin-radius-sm:12px;

  --admin-radius-md:18px;

  --admin-radius-lg:28px;


  /* transition animation */
  --admin-transition-fast:.15s;

  --admin-transition:.25s;

  --admin-transition-slow:.4s;


  /*  Shadows */
  --admin-focus-shadow:
    0 0 0 4px rgba(249,115,22,.15);

  --admin-card-shadow:
    0 6px 18px rgba(15,23,42,.06);


  --admin-disabled:#d1d5db;

  --admin-space-xs:.5rem;

  --admin-space-sm:1rem;

  --admin-space-md:1.5rem;

  --admin-space-lg:2rem;

  --admin-space-xl:3rem;

  --admin-placeholder: #9ca3af;

  


}

.admin-form{

  @apply

  space-y-6;

}

.admin-form > .admin-actions{

    padding-top:1rem;

}

.admin-field{

  @apply

  space-y-2;

}

.admin-button {

  @apply
    px-8
    py-4

    font-semibold;

  background:

    var(--admin-primary);

  color:white;

  border-radius:var(--admin-radius-lg);

  box-shadow: var(--admin-card-shadow);

  min-height:52px;

  transition:

    background-color var(--admin-transition),

    border-color var(--admin-transition),

    box-shadow var(--admin-transition),

    color var(--admin-transition);

  cursor:pointer;

}

@media (hover:hover){

  .admin-button:hover{

      background:

      var(--admin-primary-hover);

  }

}

.admin-button:focus-visible{

  outline:none;

  box-shadow: var(--admin-focus-shadow);

}

.admin-button:disabled{

  opacity:.65;

  cursor:not-allowed;

  background:

    var(--admin-disabled);

}

.admin-button-secondary{

  @apply

    px-8

    py-4

    transition

    font-medium;

    background:white;

  color:var(--admin-primary);

  border:

    1px solid

    var(--admin-primary);

  box-shadow: var(--admin-card-shadow);

  border-radius: var(--admin-radius-lg);

  cursor:pointer;

}

.admin-button-secondary:focus-visible{

  outline:none;

  box-shadow: var(--admin-focus-shadow);

}

.admin-button-medium{
  font-weight: normal !important;
  min-height:40px !important;
  padding:0 16px  !important;
  font-size:14px  !important;

}

.admin-button-small{
    min-height:40px;
    padding:.45rem .9rem;
    font-size:.9rem;
}

.admin-button-xsmall{
    min-height:30px;
    padding:.45rem .9rem;
    font-size:.9rem;
}

.admin-button-medium-bg {
  background-color: rgb(255 247 237 / var(--tw-bg-opacity, 1)) !important;
}


.admin-grid{

  @apply

  grid

  gap-6;

}

.admin-grid-2{

    @apply

    grid

    gap-6

    md:grid-cols-2;

}

.admin-input{

  @apply
    w-full

    px-4

    py-3

    transition;

  background:

    var(--admin-input-bg);

  border:

    1px solid

    var(--admin-input-border);

  border-radius:var(--admin-radius-md);

  box-shadow: none;

  min-height:52px;

  font-size:16px;

}

.admin-input:focus{

  outline:none;

  border-color:

    var(--admin-input-focus);

  box-shadow: var(--admin-focus-shadow);

}

.admin-input::placeholder{

  color:var(--admin-placeholder);

}

.admin-form-gap{height:12px;}
.admin-section-gap{height:24px;}

.admin-title{

  @apply

  sm:text-4xl

  font-semibold

  text-3xl;

  color:

    var(--admin-text);


}

.admin-subtitle{

  @apply
    text-lg;

  color:var(--admin-text-soft);

}

.admin-step{

  @apply

  text-sm

  font-semibold

  uppercase

  tracking-widest;

  color:

  var(--admin-primary);

}

.admin-container{

  background:

    var(--admin-bg);

  min-height:100vh;

}

.admin-helper{

  color:var(--admin-text-soft);

  font-size:var(--admin-font-helper);

}

.admin-success{

  color:var(--admin-success);

}

.admin-warning{

  color:var(--admin-warning);

}

.admin-error{

  color:var(--admin-error);

}

.admin-success-box{

  background: var(--admin-success-bg);

  color:var(--admin-success-color);

  border:var(--admin-success-border);

  @apply rounded-xl p-4;

}

.admin-warning-box{

  background: var(--admin-warning-bg);

  color:var(--admin-warning-color);

  border:var(--admin-warning-border);

  @apply rounded-xl p-4;

}

.admin-error-box{

  background: var(--admin-error-bg);

  color:var(--admin-error-color);;

  border:var(--admin-error-border);

  @apply 
    rounded-xl p-4;

}

.admin-spinner{

  @apply

  animate-spin

  rounded-full

  border-2;

  border-top-color:transparent;

  width:20px;

  height:20px;

}

.admin-textarea{

  @apply

  w-full

  px-4

  py-3

  transition

  min-h-32;

  background:

    var(--admin-input-bg);

  border:

    1px solid

    var(--admin-input-border);

  border-radius: var(--admin-radius-md);

  box-shadow:none;

  font-size:16px;

}

.admin-textarea:focus{

  outline:none;

  border-color:

    var(--admin-input-focus);

  box-shadow: var(--admin-focus-shadow);

}

.admin-select{

  @apply

  w-full

  px-4

  py-3;

  background:

    var(--admin-input-bg);

  border:

    1px solid

    var(--admin-input-border);

  border-radius: var(--admin-radius-md);

  box-shadow: none;

  font-size:16px;

  cursor:pointer;

}

.admin-select:focus{

  outline:none;

  border-color:

    var(--admin-input-focus);

  box-shadow: var(--admin-focus-shadow);

}

.admin-checkbox{

  width:20px;

  height:20px;

  accent-color:

    var(--admin-primary);

}

.admin-checkbox:focus-visible{

    outline:none;

    box-shadow:

        var(--admin-focus-shadow);

}

.admin-divider{

  border-top:

    1px solid

    var(--admin-border);

  @apply

  my-8;

}

.admin-actions{

  @apply

  flex

  flex-col

  gap-3

  mt-8

  sm:flex-row

  sm:justify-end;

}



.admin-label{

  @apply

    block

    mb-2

    font-medium

    text-sm;

  color:var(--admin-text);


}

.admin-section{

  @apply

  mt-10;

}

.admin-section:first-child{

  @apply

  mt-0;

}



.admin-card{
  @apply
    rounded-3xl
    p-5
    sm:p-8;
  background: var(--admin-surface);
  border:1px solid var(--admin-border);
  border-radius:var(--admin-radius-lg);
  box-shadow:var(--admin-card-shadow);
}

.admin-card-fit{
  @apply
    rounded-3xl
    p-4
    sm:p-8;
  background: var(--admin-surface);
  border:1px solid var(--admin-border);
  border-radius:var(--admin-radius-lg);
  box-shadow:var(--admin-card-shadow);
}

/* REGLA IMPORTANTE: Todo formulario usa .admin-page*/
.admin-page{

    @apply

      max-w-2xl

      mx-auto

      px-5

      py-10

      sm:px-6

      sm:py-10;

}

.admin-page-onboarding-preview{

    @apply

  

      mx-auto

      px-1

      py-1

      sm:px-1

      sm:py-1;

}

/* ESTO es contemplar menu lateral version desktop admin del organizador y mi admin  */
.admin-dashboard{

    @apply

    min-h-screen

    flex;

}

/* ESTO es contemplar menu lateral version desktop admin del organizador y mi admin  */
.admin-content{

    @apply

    flex-1

    p-8;
}

/*.admin-transition{

    transition:
      background-color var(--admin-transition),
      border-color var(--admin-transition),
      box-shadow var(--admin-transition),
      color var(--admin-transition);

}*/


[data-theme="dark"] {

  --admin-bg: #111827;

  --admin-surface: #1f2937;

  --admin-surface-soft: #374151;

  --admin-primary: #fb923c;

  --admin-primary-hover: #f97316;

  --admin-primary-soft: #7c2d12;

  --admin-disabled: #d1d5db;

  --admin-text: #f9fafb;

  --admin-text-soft: #d1d5db;

  --admin-border: #374151;

  --admin-input-bg: #1f2937;

  --admin-input-border: #4b5563;

  --admin-input-focus: #fb923c;

  --admin-success: #22c55e;

  --admin-warning: #f59e0b;

  --admin-error: #ef4444;

  --admin-success-bg: #f0fdf4;

  --admin-warning-bg: #fffbeb;

  --admin-error-bg: #fef2f2;
  
  --admin-success-color: #22c55e;

  --admin-warning-color: #92400e;

  --admin-error-color: #b91c1c;

}


/* ===================================================

   INVITACIÓN

   Variables utilizadas únicamente por los invitados

=================================================== */

/* =========================
   🎨 THEME: PINK (ACTUAL)
========================= */
.theme-pink {
  --color-bg-main: #ffffff;
  --color-bg-soft: #fce9f5;
  --color-bg-hero-from: #fce7f3;
  --color-bg-hero-to: #ffffff;

  --color-primary: #ec4899;
  --color-primary-soft: #f9a8d4;

  --color-text-main: #1f2937;
  --color-text-soft: #6b7280;

  --color-button: #374151;
  --color-button-hover: #111827;

  --color-border: #e5e7eb;
  --color-muted: #6b7280;
 
  /* 🔥 IMPORTANTE: respetamos tu valor actual */
  --hero-animation-opacity: 0.6;
    --color-bg-hero-InvitedTo: white;
}

/* =========================
   🎨 THEME: ELEGANT
========================= */
.theme-elegant {
  --color-bg-main: #ffffff !important;
  --color-bg-soft: #f3f4f6 !important;
  --color-bg-hero-from: #f3f4f6 !important;
  --color-bg-hero-to: #ffffff !important;

  --color-primary: #111827 !important;
  --color-primary-soft: #9ca3af !important;

  --color-text-main: #111827 !important;
  --color-text-soft: #6b7280 !important;

  --color-button: #111827 !important;
  --color-button-hover: #000000 !important;

  --color-border: #e5e7eb !important;
  --color-muted: #6b7280 !important;

  --hero-animation-opacity: 0.99 !important;
  --hero-animation-blur: 1px !important;
  --hero-animation-scale: 1.05 !important;
  --color-bg-hero-InvitedTo: white;
}

/* =========================
   🎨 THEME: PARTY
========================= */
.theme-party {
  --color-bg-main: #ffffff !important;
  --color-bg-soft: #ede9fe !important;
  --color-bg-hero-from: #ede9fe !important;
  --color-bg-hero-to: #f5cafc !important;

  --color-primary: #7c3aed !important;
  --color-primary-soft: #c4b5fd !important;

  --color-text-main: #1f2937 !important;
  --color-text-soft: #6b7280 !important;

  --color-button: #7c3aed !important;
  --color-button-hover: #6d28d9 !important;

  --color-border: #e5e7eb !important;
  --color-muted: #6b7280 !important;

  --hero-animation-opacity: 0.5 !important;
  --hero-animation-blur: 0px !important;
  --hero-animation-scale: 1.2 !important;
  --color-bg-hero-InvitedTo: white;
}


/* ============================================================
   🎨 PALETA 01 — ROMANTIC BLUSH
   Concepto/mood:
   Romántico, delicado, cálido y sofisticado.
   1. Motivo visual conceptual: Pétalos, flores suaves, cintas y formas orgánicas delicadas.
   2. Familia de colores: Blush, dusty rose, rosa empolvado y mauve.
   3. Intensidad: Suave.
   4. Público: Adolescentes, adultos y universal.
   5. Tipos de eventos compatibles: Birthday, FifteenthBirthday, WeddingAnniversary, BabyShower, BridalShower, Wedding, Baptism, Party, GenderReveal.
   6. Color protagonista: Rosa blush.
   7. Colores secundarios: Dusty rose, mauve y champagne.
   8. Neutros: Blanco cálido, ivory y cream.
============================================================ */
.theme-romantic-blush {
  --color-bg-main:#ffffff;
  --color-bg-soft:#fff5f8;
  --color-bg-card:#ffffff;
  --color-bg-hero-from:#f8dfe8;
  --color-bg-hero-to:#ffffff;
  --color-primary:#c94f78;
  --color-text-main:#30272b;
  --color-text-soft:#665960;
  --color-text-muted:#9c8e95;
  --color-text-on-primary:#ffffff;
  --color-text-gallery:#ffffff;
  --color-button:#a83d64;
  --color-button-hover:#8f3155;
  --color-border:#ead9df;
  --color-error:#dc2626;
  --color-success:#15803d;
  --color-bg-hero-InvitedTo:#ffffff;
  --hero-animation-opacity:.35;
  --hero-animation-blur:0px;
  --hero-animation-scale:1;
}

/* ============================================================
   🎨 PALETA 02 — PASTEL CANDY
   Concepto/mood:
   Dulce, alegre, tierno y divertido.
   1. Motivo visual conceptual: Caramelos, confites, globos pequeños y formas redondeadas.
   2. Familia de colores: Rosa pastel, lila, celeste, menta y amarillo suave.
   3. Intensidad: Suave.
   4. Público: Niños y universal.
   5. Tipos de eventos compatibles: KidsBirthday, Birthday, BabyShower, GenderReveal, Party, Communion.
   6. Color protagonista: Rosa pastel.
   7. Colores secundarios: Celeste, lavanda, menta y amarillo manteca.
   8. Neutros: Blanco y cream.
============================================================ */
.theme-pastel-candy {
  --color-bg-main:#ffffff;
  --color-bg-soft:#fffaf1;
  --color-bg-card:#ffffff;
  --color-bg-hero-from:#fde7ef;
  --color-bg-hero-to:#eef8ff;
  --color-primary:#e88aaa;
  --color-text-main:#303036;
  --color-text-soft:#686873;
  --color-text-muted:#a09fa8;
  --color-text-on-primary:#ffffff;
  --color-text-gallery:#ffffff;
  --color-button:#d96f96;
  --color-button-hover:#c55680;
  --color-border:#eee1e5;
  --color-error:#dc2626;
  --color-success:#15803d;
  --color-bg-hero-InvitedTo:#ffffff;
  --hero-animation-opacity:.28;
  --hero-animation-blur:0px;
  --hero-animation-scale:1.02;
}

/* ============================================================
   🎨 PALETA 03 — LAVENDER DREAM
   Concepto/mood:
   Soñador, mágico, delicado y ligeramente fantástico.
   1. Motivo visual conceptual: Lavanda, flores, estrellas pequeñas y formas etéreas.
   2. Familia de colores: Lavender, lilac y dusty purple.
   3. Intensidad: Suave.
   4. Público: Niños, adolescentes y adultos.
   5. Tipos de eventos compatibles: Birthday, KidsBirthday, FifteenthBirthday, BridalShower, BabyShower, Communion, Baptism, Wedding, Party.
   6. Color protagonista: Lavender.
   7. Colores secundarios: Lilac, dusty mauve y sage suave.
   8. Neutros: Ivory y blanco cálido.
============================================================ */
.theme-lavender-dream {
  --color-bg-main:#ffffff;
  --color-bg-soft:#f8f5ff;
  --color-bg-card:#ffffff;
  --color-bg-hero-from:#e9e1f8;
  --color-bg-hero-to:#ffffff;
  --color-primary:#8b72b8;
  --color-text-main:#302b35;
  --color-text-soft:#625b68;
  --color-text-muted:#98909f;
  --color-text-on-primary:#ffffff;
  --color-text-gallery:#ffffff;
  --color-button:#7560a2;
  --color-button-hover:#624e8e;
  --color-border:#e3dced;
  --color-error:#dc2626;
  --color-success:#15803d;
  --color-bg-hero-InvitedTo:#ffffff;
  --hero-animation-opacity:.32;
  --hero-animation-blur:0px;
  --hero-animation-scale:1.02;
}

/* ============================================================
   🎨 PALETA 04 — PEACH SORBET
   Concepto/mood:
   Alegre, luminoso, cálido y juvenil.
   1. Motivo visual conceptual: Duraznos, flores, atardecer y formas suaves.
   2. Familia de colores: Peach, apricot y coral suave.
   3. Intensidad: Media.
   4. Público: Niños, adolescentes, adultos y universal.
   5. Tipos de eventos compatibles: Birthday, KidsBirthday, Party, BabyShower, BridalShower, GenderReveal, Wedding, WeddingAnniversary.
   6. Color protagonista: Peach.
   7. Colores secundarios: Apricot, coral suave y dusty rose.
   8. Neutros: Ivory, arena y cream.
============================================================ */
.theme-peach-sorbet {
  --color-bg-main:#fffefd;
  --color-bg-soft:#fff5ed;
  --color-bg-card:#ffffff;
  --color-bg-hero-from:#fbdcc8;
  --color-bg-hero-to:#fffaf5;
  --color-primary:#e98262;
  --color-text-main:#382b27;
  --color-text-soft:#6b5953;
  --color-text-muted:#a2918a;
  --color-text-on-primary:#ffffff;
  --color-text-gallery:#ffffff;
  --color-button:#d96d50;
  --color-button-hover:#c4583e;
  --color-border:#edddd4;
  --color-error:#dc2626;
  --color-success:#15803d;
  --color-bg-hero-InvitedTo:#ffffff;
  --hero-animation-opacity:.3;
  --hero-animation-blur:0px;
  --hero-animation-scale:1.02;
}

/* ============================================================
   🎨 PALETA 05 — SKY & CLOUD
   Concepto/mood:
   Limpio, tranquilo, luminoso e inocente.
   1. Motivo visual conceptual: Cielo, nubes, aire y pequeñas estrellas.
   2. Familia de colores: Powder blue, sky blue y azul grisáceo.
   3. Intensidad: Suave.
   4. Público: Niños y universal.
   5. Tipos de eventos compatibles: Birthday, KidsBirthday, BabyShower, Baptism, Communion, GenderReveal, Wedding, Party.
   6. Color protagonista: Sky blue.
   7. Colores secundarios: Powder blue y dusty blue.
   8. Neutros: Blanco e ivory.
============================================================ */
.theme-sky-cloud {
  --color-bg-main:#ffffff;
  --color-bg-soft:#f2f8fc;
  --color-bg-card:#ffffff;
  --color-bg-hero-from:#dceef8;
  --color-bg-hero-to:#ffffff;
  --color-primary:#5d9fc4;
  --color-text-main:#29343a;
  --color-text-soft:#58666e;
  --color-text-muted:#929fa6;
  --color-text-on-primary:#ffffff;
  --color-text-gallery:#ffffff;
  --color-button:#4d8caf;
  --color-button-hover:#3d7899;
  --color-border:#dbe8ee;
  --color-error:#dc2626;
  --color-success:#15803d;
  --color-bg-hero-InvitedTo:#ffffff;
  --hero-animation-opacity:.28;
  --hero-animation-blur:0px;
  --hero-animation-scale:1.01;
}

/* ============================================================
   🎨 PALETA 06 — MINT CONFETTI
   Concepto/mood:
   Fresco, divertido, moderno y ligero.
   1. Motivo visual conceptual: Confetti, hojas pequeñas, globos y geometría suave.
   2. Familia de colores: Mint, aqua suave y verde agua.
   3. Intensidad: Media.
   4. Público: Niños, adolescentes y universal.
   5. Tipos de eventos compatibles: KidsBirthday, Birthday, Party, BabyShower, GenderReveal, Communion.
   6. Color protagonista: Mint.
   7. Colores secundarios: Aqua, soft turquoise y pastel yellow.
   8. Neutros: Blanco y cream.
============================================================ */
.theme-mint-confetti {
  --color-bg-main:#ffffff;
  --color-bg-soft:#f0fbf7;
  --color-bg-card:#ffffff;
  --color-bg-hero-from:#d9f3e9;
  --color-bg-hero-to:#ffffff;
  --color-primary:#49a88d;
  --color-text-main:#263532;
  --color-text-soft:#52635e;
  --color-text-muted:#8d9d98;
  --color-text-on-primary:#ffffff;
  --color-text-gallery:#ffffff;
  --color-button:#3f957d;
  --color-button-hover:#337d69;
  --color-border:#d9ebe5;
  --color-error:#dc2626;
  --color-success:#15803d;
  --color-bg-hero-InvitedTo:#ffffff;
